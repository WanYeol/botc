  </defs>
  <rect width="512" height="512" rx="72" fill="url(#bg)"/>
  <circle cx="256" cy="238" r="178" fill="none" stroke="#cbb8ff" stroke-width="14" opacity="0.95"/>
  <circle cx="256" cy="238" r="154" fill="none" stroke="#ffffff" stroke-opacity="0.14" stroke-width="2"/>
