    <rect x="132" y="354" width="248" height="58" rx="29" fill="#352653"/>
    <text x="256" y="392" text-anchor="middle" font-size="26" font-weight="700" fill="#fbf8ff" letter-spacing="2">UNALIGNED</text>
  </g>
