      <stop offset="0%" stop-color="#7750c8"/>
      <stop offset="100%" stop-color="#18151f"/>
    </radialGradient>
    <filter id="shadow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="14" stdDeviation="16" flood-color="#000000" flood-opacity="0.28"/>
